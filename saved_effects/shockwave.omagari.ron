(
    version: 2,
    triggers: [(name: "slam")],
    layers: [
        Shape((
            name: "shockwave",
            attach: Target,
            follow: PositionYaw,
            shape: Ring(inner: 0.8, outer: 1.0),
            transform: (offset: (0.0, -0.86, 0.0)),
            scale: Age([(0.0, (0.2, 1.0, 0.2)), (0.6, (3.0, 1.0, 3.0))]),
            play: OnTrigger("slam"),
            duration: Some(0.6),
            fade: (in: 0.0, out: 0.3),
            material: (
                blend: Add,
                color: Const((0.6, 1.2, 2.5, 1.0)),
                emissive: Const(1.5),
                fill: Some((axis: V, from: Const(0.3), to: Const(0.7), softness: Const(0.4))),
            ),
        )),
    ],
    preview: Some((
        stage: Model,
        camera: Game,
        model: Some("anim/tpose.glb"),
        animation: Some("mixamo.com"),
        animation_speed: 1.0,
        motion: Some(Circle(radius: 3.0, speed: 3.6)),
        auto_triggers: [("slam", 1.5)],
        root_height: 0.9,
        animation_file: Some("anim/run.glb"),
    )),
)
